{
  "name": "halalfood-world",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.4",
    "@neondatabase/serverless": "^1.1.0",
    "@vinext/cloudflare": "latest",
    "better-auth": "^1.7.4",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.45.0",
    "maplibre-gl": "^6.9.0",
    "react": "latest",
    "react-dom": "latest",
    "react-server-dom-webpack": "latest",
    "vinext": "latest"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "latest",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "@vitejs/plugin-rsc": "latest",
    "tailwindcss": "latest",
    "tsx": "^4.23.13",
    "typescript": "latest",
    "vite": "latest",
    "wrangler": "latest"
  },
  "type": "module",
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "deploy": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "backfill:places": "tsx scripts/backfill-place-coordinates.ts",
    "test:api": "node tests/api-smoke.mjs",
    "test:browser": "node tests/browser-smoke.mjs"
  },
  "engines": {
    "node": ">=22 <23"
  }
