{
  "name": "halalfood-world",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vinext dev --port 5173 --hostname 127.0.0.1",
    "build": "tsx scripts/check-build-env.ts && vinext build",
    "start": "vinext start",
    "deploy": "vinext build && wrangler deploy",
    "deploy:preview": "vinext build && wrangler preview",
    "cf:deploy": "wrangler d1 time-travel info DB && pnpm db:migrate:remote && wrangler deploy",
    "cf:preview": "pnpm db:migrate:preview && wrangler preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:migrate:preview": "tsx scripts/d1-migrate-preview.ts",
    "db:seed:local": "wrangler d1 execute DB --local --file=seed/local.sql",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test --grep @smoke",
    "e2e:ui": "playwright test --ui",
    "auth:session": "tsx scripts/dev-session.ts",
    "shot": "tsx scripts/shot.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm test:coverage",
    "verify:e2e": "pnpm verify && pnpm e2e",
    "backfill:places": "tsx scripts/backfill-place-coordinates.ts",
    "signals:listings": "tsx scripts/import-listing-signals.ts",
    "places:export": "tsx scripts/places-seed.ts export",
    "places:import": "tsx scripts/places-seed.ts import"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.4",
    "@datafast/ai-crawl": "^1.0.9",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@sentry/cloudflare": "^11.4.0",
    "@sentry/react": "^11.4.0",
    "@vinext/cloudflare": "1.0.0-beta.10",
    "better-auth": "^1.7.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "crisp-sdk-web": "^1.2.1",
    "datafast": "^3.0.18",
    "drizzle-orm": "^0.45.2",
    "maplibre-gl": "^6.9.0",
    "next": "^16.0.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-server-dom-webpack": "^19.3.0",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vinext": "1.0.0-beta.12"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.8",
    "@cloudflare/workers-types": "^4.20250913.0",
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.36.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^8.3.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.141.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "sharp"
    ]
  }
}
