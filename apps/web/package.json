    "test:api": "node tests/api-smoke.mjs",
    "test:browser": "node tests/browser-smoke.mjs",
    "db:migrate:local": "wrangler d1 migrations apply halalfood-world --local",
    "db:migrate:remote": "tsx scripts/apply-d1-migrations.ts"
