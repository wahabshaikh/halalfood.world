{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "halalfood-world",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Custom entry wraps vinext/server/fetch-handler with Sentry. The build emits
  // the bundled file as `main` in dist/server/wrangler.json.
  "main": "./worker/index.ts",
  "preview_urls": true,
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "HALAL_EVIDENCE_R2",
      "bucket_name": "halalfood-world-evidence"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "halalfood-world",
      // Replace with the id printed by `wrangler d1 create halalfood-world`.
      "database_id": "3e4b080f-0559-4235-9923-2d6e4dec528f",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://halalfood.world",
    // Public DSN (it also ships in the browser bundle). Do not also set this
    // name with `wrangler secret put`; a var and a secret conflict on deploy.
    "SENTRY_DSN": "https://628e981cc4682959d5a7b79f0b73ecea@o4512156631171073.ingest.us.sentry.io/4512190880284672",
    // Global Places Text Search calls per UTC day. Cache hits do not count.
    "GOOGLE_SEARCH_DAILY_CAP": "1000"
  },
  // Per-location burst limits for paid Places Text Search. namespace_id is an
  // account-wide integer: 81001 is anonymous (per IP), 81002 is signed-in
  // (per user). Preview uploads rewrite these so they do not share counters.
  "ratelimits": [
    {
      "name": "GOOGLE_SEARCH_ANON",
      "namespace_id": "81001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "GOOGLE_SEARCH_USER",
      "namespace_id": "81002",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ],
  "cache": {
    "enabled": true
  },
  // Workers Logs. head_sampling_rate 1 keeps every request until launch
  // traffic is high enough to sample. A later deploy keeps this setting.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
