{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm ci)",
      "Bash(npm run check)",
      "Bash(npm run typecheck)",
      "Bash(npm test)",
      "Bash(npm run build)",
      "Bash(npm run dev)",
      "Bash(npm run db:migrate:local)",
      "Bash(npm run test:api)",
      "Bash(npm run test:browser)",
      "Bash(npx tsx --test:*)",
      "Bash(npm run typecheck -w:*)",
      "Bash(npm test -w:*)"
    ],
    "deny": [
      "Bash(npm run deploy:*)",
      "Bash(npm run db:migrate:remote:*)",
      "Bash(npx wrangler deploy:*)",
      "Bash(npx wrangler d1 migrations apply halalfood-world --remote:*)",
      "Read(./apps/web/.dev.vars)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills"
      }
    }
  },
  "enabledPlugins": {
    "cloudflare@cloudflare": true
  }
}
